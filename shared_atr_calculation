def test_atr_calculation_accuracy(test_data=None):
    """
    Test ATR calculation against known reference values
    Useful for validating the implementation
    """
    if test_data is None:
        # Create simple test data
        test_data = pd.DataFrame({
            'Date': pd.date_range('2024-01-01', periods=20),
            'Open': [100 + i for i in range(20)],
            'High': [102 + i for i in range(20)], 
            'Low': [98 + i for i in range(20)],
            'Close': [101 + i for i in range(20)]
        })
    
    # Calculate ATR
    atr_result = calculate_atr_with_validation(test_data, period=14)
    
    # Basic validation
    print("ATR Calculation Test Results:")
    print(f"Valid ATR values: {atr_result['valid_count']}")
    print(f"Validation passed: {atr_result['validation_passed']}")
    for msg in atr_result['messages']:
        print(f"  - {msg}")
    
    if atr_result['valid_count'] > 0:
        atr_series = atr_result['atr_series']
        print(f"ATR range: {atr_series.min():.4f} to {atr_series.max():.4f}")
        
        # Test level generation
        last_valid_idx = atr_series.last_valid_index()
        if last_valid_idx is not None:
            test_close = test_data.loc[last_valid_idx, 'Close']
            test_atr = atr_series.loc[last_valid_idx]
            levels = generate_fibonacci_levels(test_close, test_atr)
            
            print(f"\nFibonacci Levels Test (Close={test_close}, ATR={test_atr:.4f}):")
            for level_name, level_value in sorted(levels.items()):
                if level_name.startswith('+') or level_name.startswith('-'):
                    print(f"  {level_name}: {level_value}")
    
    return atr_result

