def validate_ohlc_data(df, check_logical_consistency=True):
    """
    Validate OHLC data for ATR calculation
    
    Args:
        df: DataFrame with OHLC data
        check_logical_consistency: Check if High >= Low, etc.
    
    Returns:
        dict: Validation results
    """
    issues = []
    warnings = []
    
    # Check required columns
    required_cols = ['Open', 'High', 'Low', 'Close']
    missing_cols = [col for col in required_cols if col not in df.columns]
    if missing_cols:
        issues.append(f'Missing required columns: {missing_cols}')
        return {'valid': False, 'issues': issues, 'warnings': warnings}
    
    # Check for null values
    null_counts = df[required_cols].isnull().sum()
    for col, count in null_counts.items():
        if count > 0:
            warnings.append(f'{col} has {count} null values')
    
    # Check data types
    for col in required_cols:
        if not pd.api.types.is_numeric_dtype(df[col]):
            issues.append(f'{col} is not numeric type: {df[col].dtype}')
    
    if check_logical_consistency:
        # Check High >= Low
        invalid_high_low = (df['High'] < df['Low']).sum()
        if invalid_high_low > 0:
            issues.append(f'{invalid_high_low} rows where High < Low')
        
        # Check High >= Open, Close and Low <= Open, Close
        invalid_high_open = (df['High'] < df['Open']).sum()
        invalid_high_close = (df['High'] < df['Close']).sum()
        invalid_low_open = (df['Low'] > df['Open']).sum()
        invalid_low_close = (df['Low'] > df['Close']).sum()
        
        for check, count in [
            ('High < Open', invalid_high_open),
            ('High < Close', invalid_high_close), 
            ('Low > Open', invalid_low_open),
            ('Low > Close', invalid_low_close)
        ]:
            if count > 0:
                warnings.append(f'{count} rows where {check}')
    
    # Check for zero or negative prices
    negative_prices = (df[required_cols] <= 0).any(axis=1).sum()
    if negative_prices > 0:
        issues.append(f'{negative_prices} rows with zero or negative prices')
    
    return {
        'valid': len(issues) == 0,
        'issues': issues,
        'warnings': warnings,
        'total_rows': len(df),
        'null_counts': null_counts.to_dict()
    }

def create_session_identifiers(df, date_column='Date', method='sequential'):
    """
    Create session identifiers for compatibility with analyzer
    
    Args:
        df: DataFrame
        date_column: Column containing dates
        method: 'sequential' or 'datetime_based'
    
    Returns:
        pd.Series: Session identifiers
    """
    if method == 'sequential':
        # Simple sequential numbering within each date
        return df.groupby(date_column).cumcount().apply(lambda x: f"{df.loc[x, date_column]}_{x:04d}")
    else:
        # Datetime-based if available
        if 'Datetime' in df.columns:
            return df['Datetime'].dt.strftime('%Y%m%d_%H%M%S')
        else:
            # Fallback to sequential
            return create_session_identifiers(df, date_column, 'sequential')

