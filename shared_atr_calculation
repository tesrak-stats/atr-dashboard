"""
Shared ATR Calculation Module
Single source of truth for ATR and Fibonacci level calculations
Used by both enhanced_csv_handler and yml scheduler for consistency
"""

import pandas as pd
import numpy as np
from datetime import datetime

# ========================================================================================
# CORE ATR CALCULATION FUNCTIONS
# ========================================================================================

def calculate_true_range_row(row):
    """
    Calculate True Range for a single row
    Extracted from proven yml scheduler implementation
    """
    if pd.isna(row["Prev_Close"]):
        return row["High"] - row["Low"]
    
    return max(
        row["High"] - row["Low"],
        abs(row["High"] - row["Prev_Close"]),
        abs(row["Low"] - row["Prev_Close"])
    )

def calculate_true_wilders_atr(df, period=14):
    """
    Calculate TRUE Wilder's ATR exactly matching yml scheduler methodology
    This is the proven function from the three-phase system
    
    Args:
        df: DataFrame with OHLC data
        period: ATR period (default 14)
    
    Returns:
        pd.Series: ATR values with same index as input df
    """
    if len(df) < period:
        return pd.Series([np.nan] * len(df), index=df.index)
    
    # Calculate True Range components exactly like proven system
    df_copy = df.copy()
    df_copy["Prev_Close"] = df_copy["Close"].shift(1)
    
    # Calculate True Range for each row
    df_copy["TR"] = df_copy.apply(calculate_true_range_row, axis=1)
    
    # Calculate TRUE Wilder's ATR using EXACT same logic as daily_atr_updater.py
    atr_values = [None] * len(df_copy)
    
    for i in range(len(df_copy)):
        if i < period - 1:
            # No ATR until we have enough data
            atr_values[i] = None
        elif i == period - 1:
            # First ATR = average of first period TR values
            atr_values[i] = df_copy["TR"].iloc[0:i+1].mean()
        else:
            # Subsequent ATR = 1/period*current_TR + (1-1/period)*previous_ATR
            prev_atr = atr_values[i-1]
            current_tr = df_copy["TR"].iloc[i]
            atr_values[i] = (1/period) * current_tr + (1 - 1/period) * prev_atr
    
    return pd.Series(atr_values, index=df.index)

def calculate_atr_with_validation(df, period=14, min_rows_required=None):
    """
    Calculate ATR with validation and detailed reporting
    
    Args:
        df: DataFrame with OHLC data
        period: ATR period
        min_rows_required: Minimum rows needed (default: period + 10 for stability)
    
    Returns:
        dict: {
            'atr_series': pd.Series with ATR values,
            'valid_count': int number of valid ATR values,
            'validation_passed': bool,
            'messages': list of validation messages
        }
    """
    if min_rows_required is None:
        min_rows_required = period + 10
    
    messages = []
    validation_passed = True
    
    # Validate input data
    if df is None or len(df) == 0:
        return {
            'atr_series': pd.Series([]),
            'valid_count': 0,
            'validation_passed': False,
            'messages': ['Input dataframe is empty or None']
        }
    
    # Check required columns
    required_cols = ['Open', 'High', 'Low', 'Close']
    missing_cols = [col for col in required_cols if col not in df.columns]
    if missing_cols:
        return {
            'atr_series': pd.Series([np.nan] * len(df), index=df.index),
            'valid_count': 0,
            'validation_passed': False,
            'messages': [f'Missing required columns: {missing_cols}']
        }
    
    # Check data sufficiency
    if len(df) < period:
        validation_passed = False
        messages.append(f'Insufficient data: {len(df)} rows, need at least {period}')
    elif len(df) < min_rows_required:
        messages.append(f'Limited data: {len(df)} rows, recommended {min_rows_required}+ for stability')
    
    # Calculate ATR
    atr_series = calculate_true_wilders_atr(df, period)
    valid_count = atr_series.notna().sum()
    
    if valid_count == 0:
        validation_passed = False
        messages.append('No valid ATR values generated')
    else:
        messages.append(f'Generated {valid_count} valid ATR values from {len(df)} rows')
    
    return {
        'atr_series': atr_series,
        'valid_count': valid_count,
        'validation_passed': validation_passed,
        'messages': messages
    }

# ========================================================================================
# FIBONACCI LEVEL GENERATION
# ========================================================================================

def get_standard_fibonacci_ratios():
    """Get the standard Fibonacci ratios used across the system"""
    return [1.0, 0.786, 0.618, 0.5, 0.382, 0.236, 0.0,
            -0.236, -0.382, -0.5, -0.618, -0.786, -1.0]

def generate_fibonacci_levels(reference_close, atr, custom_ratios=None):
    """
    Generate Fibonacci levels using EXACT same logic as yml scheduler
    Matches the proven three-phase system perfectly
    
    Args:
        reference_close: Reference price (usually previous close)
        atr: ATR value
        custom_ratios: Optional custom ratios (uses standard if None)
    
    Returns:
        dict: All level formats for maximum compatibility
    """
    if custom_ratios is None:
        fib_ratios = get_standard_fibonacci_ratios()
    else:
        fib_ratios = custom_ratios
    
    levels = {}
    
    for ratio in fib_ratios:
        level_price = reference_close + (ratio * atr)
        
        # Format 1: Exact yml scheduler format (+1.000, -0.618, etc.)
        levels[f"{ratio:+.3f}"] = round(level_price, 2)
        
        # Format 2: ATR_ format for analyzer compatibility
        if ratio == 0.0:
            levels['ATR_000'] = round(level_price, 2)
            levels['Daily_Close'] = round(level_price, 2)
        elif ratio > 0:
            ratio_str = f"{int(ratio*1000):03d}"
            levels[f'ATR_{ratio_str}'] = round(level_price, 2)
        else:
            ratio_str = f"{int(abs(ratio)*1000):03d}"  
            levels[f'ATR_neg{ratio_str}'] = round(level_price, 2)
    
    # Add the ATR value itself for reference
    levels['Daily_ATR'] = round(atr, 2)
    
    return levels

def generate_fibonacci_levels_batch(df, atr_column='ATR', close_column='Close', 
                                   reference_close_method='previous'):
    """
    Generate Fibonacci levels for entire dataframe
    
    Args:
        df: DataFrame with OHLC and ATR data
        atr_column: Name of ATR column
        close_column: Name of close price column
        reference_close_method: 'previous' (use previous close) or 'current' (use current close)
    
    Returns:
        pd.DataFrame: Original data with level columns added
    """
    result_df = df.copy()
    
    # Get all possible level column names from one calculation
    if len(df) > 0 and not pd.isna(df[atr_column].iloc[0]):
        sample_levels = generate_fibonacci_levels(df[close_column].iloc[0], df[atr_column].iloc[0])
        level_columns = list(sample_levels.keys())
    else:
        # Fallback - create empty columns
        fib_ratios = get_standard_fibonacci_ratios()
        level_columns = []
        for ratio in fib_ratios:
            level_columns.append(f"{ratio:+.3f}")
            if ratio == 0.0:
                level_columns.extend(['ATR_000', 'Daily_Close'])
            elif ratio > 0:
                ratio_str = f"{int(ratio*1000):03d}"
                level_columns.append(f'ATR_{ratio_str}')
            else:
                ratio_str = f"{int(abs(ratio)*1000):03d}"
                level_columns.append(f'ATR_neg{ratio_str}')
        level_columns.append('Daily_ATR')
    
    # Initialize level columns
    for col in level_columns:
        result_df[col] = np.nan
    
    # Calculate levels for each row
    for i, row in df.iterrows():
        if pd.isna(row[atr_column]):
            continue
            
        # Determine reference close
        if reference_close_method == 'previous' and i > 0:
            reference_close = df.iloc[i-1][close_column]
        else:
            reference_close = row[close_column]
        
        # Generate levels
        levels = generate_fibonacci_levels(reference_close, row[atr_column])
        
        # Assign to result dataframe
        for level_name, level_value in levels.items():
            if level_name in result_df.columns:
                result_df.loc[i, level_name] = level_value
    
    return result_df

